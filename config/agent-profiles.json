{
  "schemaVersion": 1,
  "organization": "TheOrg",
  "releaseStatus": "playbook-prompt-runtime-wired;no-model-fine-tuning-or-automated-provider-access",
  "principles": [
    "Permanent profiles do not imply continuously running LLM sessions.",
    "A specialist may open only its own tracked Chrome task tabs.",
    "Model responses never grant permissions or attest real-world completion.",
    "Only explicit verified integration registrations make a plugin callable.",
    "ChatGPT account plugin authorizations do not transfer to TheOrg.",
    "External write operations need separate, revocable authorization.",
    "QA cannot approve work it performed; security cannot override owner approvals."
  ],
  "defaultPermission": "deny",
  "maxSpecialistsPerWorkOrder": 8,
