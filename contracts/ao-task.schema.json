{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AO Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestId",
    "taskId",
    "toolId",
    "tenantId",
    "principalId",
    "intent"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 8
    },
    "taskId": {
      "type": "string",
      "minLength": 8
    },
    "toolId": {
      "type": "string"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "principalId": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object"
    },
    "approvalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
