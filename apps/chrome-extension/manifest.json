{
  "manifest_version": 3,
  "name": "TheOrg — Supervisor Workspace",
  "version": "0.3.0",
  "description": "Local-first AI Supervisor with explicit task-scoped ChatGPT/Claude automation (developer preview).",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "sidePanel",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open TheOrg Supervisor"
  },
  "side_panel": {
    "default_path": "home.html"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ]
}
