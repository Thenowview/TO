{
  "manifest_version": 3,
  "name": "GIZE AI — Supervisor Workspace",
  "version": "0.4.0",
  "description": "Local-first Windows Supervisor with reviewed optional Ollama agents and durable SQLite jobs (developer preview).",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open GIZE AI Supervisor"
  },
  "side_panel": {
    "default_path": "home.html"
  },
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}

